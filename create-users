for user in enfant internet jeux emulation
do 
  useradd --password=$(mkpasswd $user) --groups tty,users,audio,video,root,vboxusers,pulse,lpadmin,lp,disk,colord $user 
  install -d /home/$user   
  chown $user /home/$user   
  install -d /home/$user/.config/ydfs
  echo lang=French > /home/$user/.config/ydfs/lang
  chown -R $user /home/$user/.config   
done

echo '  
install -d /flatpak/home     
ls /home | while read home
do
  echo $home | grep linuxconsole && continue
  if [ ! -e /flatpak/home/$home ] 
  then
      mv /home/$home /flatpak/home && ln -s /flatpak/home/$home /home/$home
  else
      rmdir /home/$home
      ln -s /flatpak/home/$home /home/$home
  fi
done   
' >> /ydfs/enable/flapak-disk    
