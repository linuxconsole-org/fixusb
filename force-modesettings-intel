MODESETTING=""
if [ ! -e /ydfs/boot/options/nomodesetting ]
then
  lspci | grep VGA | grep -i intel && MODESETTING=OK

  if [ "$MODESETTING" == "OK" ]
  then
    rm /home/linuxconsole2026/x86_64/lib/xorg/modules/drivers/intel_drv*
  else
    cp /ydfs/modules/x86_64/lib/xorg/modules/drivers/intel_drv.* /home/linuxconsole2026/x86_64/lib/xorg/modules/drivers/
  fi
fi

echo
